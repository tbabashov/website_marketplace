# ============================================================================
# WebSale.az — environment
# ----------------------------------------------------------------------------
# Copy to .env.local and fill in. Every variable is optional: with none of them
# set the site still builds and runs, showing demo content and clearly-marked
# placeholders. Nothing here is a secret in the usual sense — everything with a
# VITE_ prefix is compiled into the client bundle and is visible to anyone who
# opens dev tools. Do not put a Supabase service-role key in this file.
# ============================================================================

# --- Backend (Supabase) -----------------------------------------------------
# Project Settings → API. The anon key is meant to be public; row-level
# security is what protects the data, not the key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Site identity ----------------------------------------------------------
# No trailing slash. Used for canonical URLs, OpenGraph tags and the sitemap.
VITE_SITE_URL=https://websale.az
VITE_OWNER_NAME=
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_CONTACT_WHATSAPP=

# --- Social (leave blank to hide the link entirely) -------------------------
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_LINKEDIN=
VITE_SOCIAL_GITHUB=
VITE_SOCIAL_TELEGRAM=

# --- Receiving payments -----------------------------------------------------
# These are the details buyers transfer TO, shown on the checkout page.
#
# There is deliberately no variable for a CVV or an expiry date, and no form
# field for one anywhere in this codebase. A card number and an IBAN are all
# that is needed to receive money; CVV and expiry are what you need to SPEND
# from a card. If any tool or person ever asks you to add them here, that is
# the moment to stop.
VITE_PAY_BANK_NAME=
VITE_PAY_ACCOUNT_HOLDER=
VITE_PAY_CARD_NUMBER=
VITE_PAY_IBAN=
# Free text, e.g. "m10, Birbank, Leobank"
VITE_PAY_WALLETS=

# Deposit share offered on custom orders and (optionally) ready-made ones.
# 0 turns the deposit split off entirely and everything is paid in full.
VITE_DEPOSIT_PERCENT=40

# --- Second display currency (optional) -------------------------------------
# Prices are always charged in AZN. Setting this adds an approximate second
# line for visitors abroad. The rate is manual — update it when it drifts.
# Leave blank to show AZN only.
VITE_SECONDARY_CURRENCY=
VITE_SECONDARY_RATE=0.59

# --- Proof bar on the landing page ------------------------------------------
# Your real numbers, from your own records. Anything left blank renders as an
# em dash with "not filled in yet" underneath — which is the honest state until
# you have the figure. Do not put an aspirational number here.
VITE_STAT_SITES_SHIPPED=
VITE_STAT_INDUSTRIES=
VITE_STAT_TURNAROUND_WEEKS=
VITE_STAT_YEARS=
